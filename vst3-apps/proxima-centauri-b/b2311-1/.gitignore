# Build output. This MUST be here before the first `git add`: build/ runs to
# hundreds of megabytes and test/build/ to tens, and anything added once stays
# in history for good, however thoroughly it is deleted afterwards.
build/
test/build/

# Generated, and regenerable: probe renders and panel captures.
aud/
shots/

# Loose artefacts from the SAC hash-nudge dance and from bench runs.
*.exe
*.wav
*.old*

# Editors and the OS
.vs/
.vscode/
*.user
Thumbs.db
desktop.ini

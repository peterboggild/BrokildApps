[
  { "name": "hook", "eval": "typeof window.__N84 === 'object' ? 'ok' : 'NO HOOK'" },
  { "wait": 1500 },
  { "name": "no HTML select visible", "eval": "Array.prototype.every.call(document.querySelectorAll('select'), function (s) { return s.offsetWidth === 0; }) ? 'none visible' : 'A SELECT IS VISIBLE'" },
  { "name": "BLADE BRASS", "eval": "window.__JUCE__.backend.emitEvent('n84', {k:'patch', i:0}); 'asked'" },
  { "wait": 900 },
  { "name": "window text", "eval": "document.getElementById('pwinnum').textContent + ' ' + document.getElementById('pwintxt').textContent" },
  { "name": "deck", "shoot": "C:\\Users\\peter\\b\\Nineteen84\\docs\\choosers-deck.png", "sel": "#deck", "scale": 2 },
  { "name": "feet switch", "shoot": "C:\\Users\\peter\\b\\Nineteen84\\docs\\choosers-feet.png", "sel": "[data-id=a_oct]", "pad": 6, "scale": 4 },
  { "name": "circuit switch", "shoot": "C:\\Users\\peter\\b\\Nineteen84\\docs\\choosers-circuit.png", "sel": "[data-id=a_fmode]", "pad": 6, "scale": 4 },
  { "name": "mode + quality", "shoot": "C:\\Users\\peter\\b\\Nineteen84\\docs\\choosers-mode.png", "sel": "[data-id=mode]", "sel2": "[data-id=os]", "pad": 8, "scale": 3 },
  { "name": "drag the FEET slot to the bottom", "eval": "(function(){ var c = document.querySelector('[data-id=a_oct]'); var s = c.querySelector('.sslot'); var r = s.getBoundingClientRect(); s.dispatchEvent(new PointerEvent('pointerdown', {bubbles:true, clientX:r.left+3, clientY:r.bottom-1, button:0, pointerId:1})); s.dispatchEvent(new PointerEvent('pointerup', {bubbles:true, clientX:r.left+3, clientY:r.bottom-1, button:0, pointerId:1})); return 'a_oct = ' + window.__N84.get('a_oct'); })()" },
  { "name": "click the 32 legend", "eval": "(function(){ document.querySelector('[data-id=a_oct] .seg b').click(); return 'a_oct = ' + window.__N84.get('a_oct'); })()" },
  { "wait": 300 },
  { "name": "feet switch after", "shoot": "C:\\Users\\peter\\b\\Nineteen84\\docs\\choosers-feet2.png", "sel": "[data-id=a_oct]", "pad": 6, "scale": 4 },
  { "name": "open the chart", "eval": "document.getElementById('pwin').click(); document.getElementById('pmenu') ? 'open, ' + document.querySelectorAll('#pmenu .pi').length + ' entries, ' + document.querySelectorAll('#pmenu .pc').length + ' columns' : 'NO MENU'" },
  { "wait": 300 },
  { "name": "chart", "shoot": "C:\\Users\\peter\\b\\Nineteen84\\docs\\choosers-chart.png", "sel": "#pmenu", "pad": 8, "scale": 2 },
  { "name": "header with chart", "shoot": "C:\\Users\\peter\\b\\Nineteen84\\docs\\choosers-header.png", "sel": "#hbtns", "sel2": "#pmenu", "pad": 10, "scale": 2 },
  { "name": "reopen (a screenshot fires a resize, and a resize closes the chart)", "eval": "document.getElementById('pmenu') ? 'open' : (document.getElementById('pwin').click(), 'reopened')" },
  { "name": "pick entry 8", "eval": "document.querySelectorAll('#pmenu .pi')[7].click(); 'picked'" },
  { "wait": 700 },
  { "name": "window + display after the pick", "eval": "document.getElementById('pwinnum').textContent + ' ' + document.getElementById('pwintxt').textContent + ' | vfd: ' + document.getElementById('pname').textContent + ' | menu ' + (document.getElementById('pmenu') ? 'STILL OPEN' : 'closed')" },
  { "name": "errors", "eval": "(window.__errs || []).length === 0 ? 'no errors' : 'ERRORS: ' + JSON.stringify(window.__errs).slice(0, 300)" }
]

[
  { "name": "open the landing page", "cmd": "Page.navigate", "params": { "url": "http://127.0.0.1:8097/vst3-apps/thirty-thousand-years/index.html" } },
  { "name": "settle", "eval": "new Promise(function(r){setTimeout(r,2200)})" },
  { "name": "scroll the whole page so lazy images load",
    "eval": "(function(){return new Promise(function(r){var y=0;var t=setInterval(function(){y+=600;window.scrollTo(0,y);if(y>document.body.scrollHeight){clearInterval(t);window.scrollTo(0,0);setTimeout(r,900)}},90)})})()" },
  { "name": "the title reads right", "eval": "document.querySelector('h1') ? document.querySelector('h1').textContent.replace(/\\s+/g,' ').trim() : 'no h1'" },
  { "name": "every image loaded",
    "eval": "(function(){var bad=[],n=0;Array.prototype.forEach.call(document.images,function(i){n++;if(!i.complete||i.naturalWidth===0)bad.push(i.getAttribute('src'))});return n+' images, '+(bad.length?('BROKEN: '+bad.join(', ')):'none broken')})()" },
  { "name": "the download button points at the release asset",
    "eval": "(function(){var a=Array.prototype.slice.call(document.querySelectorAll('a')).filter(function(x){return /\\.zip$/.test(x.getAttribute('href')||'')});return a.length?a.map(function(x){return x.getAttribute('href')+'  [text: '+x.textContent.replace(/\\s+/g,' ').trim().slice(0,60)+']'}).join(' | '):'NO ZIP LINK'})()" },
  { "name": "no placeholder survived", "eval": "(/DOWNLOAD_URL|DOWNLOAD_SIZE/.test(document.body.innerHTML) ? 'PLACEHOLDER STILL PRESENT' : 'none left')" },
  { "name": "the manual link resolves",
    "eval": "(function(){var a=Array.prototype.slice.call(document.querySelectorAll('a')).filter(function(x){return /\\.pdf$/.test(x.getAttribute('href')||'')});return a.length?a[0].getAttribute('href'):'no pdf link'})()" },
  { "name": "four audio players", "eval": "document.querySelectorAll('audio').length + ' audio elements'" },
  { "name": "the shared black bar is present", "eval": "document.querySelector('.topbar') ? 'topbar present' : 'NO TOPBAR'" },
  { "name": "no sideways scroll at desktop width", "eval": "document.documentElement.scrollWidth + ' content in ' + window.innerWidth + ' viewport'" },
  { "name": "js errors", "eval": "(window.__ERRS||[]).length + ' captured'" },

  { "name": "now the FRONT page", "cmd": "Page.navigate", "params": { "url": "http://127.0.0.1:8097/" } },
  { "name": "settle", "eval": "new Promise(function(r){setTimeout(r,2200)})" },
  { "name": "scroll to load the cards",
    "eval": "(function(){return new Promise(function(r){var y=0;var t=setInterval(function(){y+=700;window.scrollTo(0,y);if(y>document.body.scrollHeight){clearInterval(t);setTimeout(r,1200)}},90)})})()" },
  { "name": "is the card there, and tagged?",
    "eval": "(function(){var a=Array.prototype.slice.call(document.querySelectorAll('a')).filter(function(x){return /thirty-thousand-years/.test(x.getAttribute('href')||'')});if(!a.length)return 'NO CARD';var card=a[0].closest('article')||a[0].closest('.card')||a[0].parentElement;return 'card found, link '+a[0].getAttribute('href')+'  |  '+card.textContent.replace(/\\s+/g,' ').trim().slice(0,150)})()" },
  { "name": "its preview drew", "eval": "(function(){var i=Array.prototype.slice.call(document.images).filter(function(x){return /thirty-thousand-years/.test(x.getAttribute('src')||'')});return i.length?(i[0].naturalWidth+'x'+i[0].naturalHeight):'no preview img'})()" },
  { "name": "front page js errors", "eval": "(window.__ERRS||[]).length + ' captured'" }
]

# Build trees. The benches and the DSW host write into the source folder on
# purpose (CMakeLists sets RUNTIME_OUTPUT_DIRECTORY there so `./dsw` just
# runs), which makes it easy to commit a binary by accident.
build/
*/build/
test/build/
cmake-build-*/

# Bench and probe executables, built straight into test/ by the g++ one-liners
# in the workflows and by hand while arguing with the DSP.
BrokildWorldFX/test/bwfxtest
rite-of-passage/test/roptest
vocal-harmonizer/test/legiontest
vst3-apps/clone-wars/plugin/test/render_test
vst3-apps/clone-wars/plugin/test/audit
vst3-apps/clone-wars/plugin/test/wavs/

# The DSW host and the experiment bundles it loads.
dsw/dsw
dsw/dsw.exe
dsw/plugins/*/*.so
dsw/plugins/*/*.dll
dsw/plugins/*/*.dylib

# Compiled objects and libraries anywhere.
*.o
*.obj
*.a
*.lib
*.exp
*.ilk
*.pdb

# Rendered audio from the benches. The renders are evidence for one run, not
# artefacts - CI uploads them, the repo should not carry them.
*.wav

# JUCE fetches itself at configure time.
**/JUCE/
**/_deps/

# WebView2, fetched by NuGet in the Clone Wars workflow.
vst3-apps/*/plugin/webview2/

# The house-style release folder a local package step builds before zipping.
vst3-apps/*/plugin/package/

# OS and editor droppings.
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# The collection archive is a GitHub Release asset, not a file in the repo:
# at eleven plugins it is 101 MB and GitHub rejects any file over 100 MB.
# See vst3-apps/collection/contents.json for the url it is published at.
vst3-apps/collection/Brokild-Collection-win64.zip

# Plug-in downloads. These live on the `downloads` GitHub release, not in the
# repository: a repo that holds its own binaries grows by the size of a build
# every time one is cut, which is how this one reached 1.9 GB. Each plug-in's
# app.json declares the url, the byte count and the sha256 of its file, and
# tools/verify-downloads.js proves a stranger can fetch exactly those bytes.
# The zips stay on disk here as ordinary build output.
vst3-apps/*/*.zip
vst3-apps/*/*/*.zip

# The publish tool' scratch report: which zips it last uploaded, and their
# hashes. Transient, rewritten every run, and it was tracked by accident.
tools/.downloads-report.json
